generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// 1. USUARIOS (Admin y Clientes)
// ==============================
enum Role {
  ADMIN
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CLIENT)
  
  // Si usa contraseña tradicional
  password      String?   
  
  orders        Order[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==============================
// 2. PRODUCTOS (Catálogo Multi-Tienda)
// ==============================
model Product {
  id            String   @id @default(cuid())
  slug          String   @unique // Ej: anillo-oro-18k
  name          String
  description   String   @db.Text
  
  // Manejo de visibilidad (Arquitectura Multi-Tienda)
  isRetail      Boolean  @default(true)  // ¿Se ve en la tienda pública?
  isWholesale   Boolean  @default(false) // ¿Se ve en el enlace secreto?
  isPromo       Boolean  @default(false) // ¿Aparece en la sección de promociones de la home?
  
  // Precios
  retailPrice   Float
  originalPrice Float?   // Precio original antes de la promoción (para calcular % descuento)
  wholesalePrice Float?
  
  // Inventario y Características
  stock         Int      @default(0)
  material      String?  // Ej: Oro laminado, Plata 925
  weight        Float?   // Peso en gramos
  size          String?  // Medida visible: "40 cm" (cadenas), "Talla 7" (anillos), etc.
  
  // Imágenes (Cloudinary) - Guardamos un array de URLs
  images        String[] // ["https://res.cloudinary.com/...", "..."]
  
  // Relaciones
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Índices para las consultas más frecuentes del catálogo: filtrado por
  // tienda (isRetail/isWholesale) + categoría, ordenado por fecha de alta.
  @@index([isRetail, categoryId, createdAt])
  @@index([isWholesale, categoryId, createdAt])
  @@index([categoryId])
}

// ==============================
// 3. CATEGORÍAS
// ==============================
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==============================
// 4. PEDIDOS PAGADOS EN LÍNEA (Wompi)
// ==============================
// Un pedido nace PENDING en /api/checkout, justo antes de mandar al cliente a
// Wompi, y SOLO el webhook de Wompi lo mueve a un estado final: la URL a la
// que vuelve el cliente no es prueba de pago. Los pedidos por WhatsApp no
// pasan por aquí.
enum OrderStatus {
  PENDING  // creado, esperando el pago
  PAID     // Wompi respondió APPROVED
  DECLINED // rechazado por el banco o el medio de pago
  VOIDED   // anulado
  ERROR    // falló del lado de Wompi o del medio de pago
}

model Order {
  id          String      @id @default(cuid())
  // La referencia que se firma y viaja a Wompi; con ella el webhook ubica el
  // pedido y el cliente lo consulta en /pedido/[referencia].
  reference   String      @unique
  status      OrderStatus @default(PENDING)

  userId      String?     // Opcional: se puede comprar sin iniciar sesión
  user        User?       @relation(fields: [userId], references: [id])

  // Copia de las piezas al momento de pagar (productId, slug, nombre, talla,
  // cantidad, precio unitario): si luego cambia el catálogo, el pedido no.
  items       Json

  // Importes en pesos, igual que Product.retailPrice.
  subtotal     Float
  shippingCost Float
  totalAmount  Float
  // El monto exacto que se firmó para Wompi. El webhook tiene que traer este
  // mismo número; si no, el pedido no se marca como pagado.
  amountInCents Int
  currency     String     @default("COP")

  // Datos de contacto y envío que llena el cliente en el checkout.
  customerName       String
  customerEmail      String
  customerPhone      String
  shippingAddress    String
  shippingCity       String
  shippingDepartment String
  shippingNotes      String?  // barrio, apartamento, indicaciones

  // Lo que devuelve Wompi al confirmar el pago.
  wompiTransactionId String?  @unique
  paymentMethod      String?  // CARD, PSE, NEQUI, BANCOLOMBIA_TRANSFER...
  paidAt             DateTime?
  // El stock se revisa al crear el pedido pero se descuenta al confirmarse el
  // pago: si entre medias otra persona pagó la última pieza, el pago ya está
  // hecho y no se puede rechazar. Se marca aquí para que el admin lo resuelva
  // (conseguir la pieza o devolver el dinero).
  stockShortage      Boolean   @default(false)
  // Lo marca el admin cuando despacha el pedido.
  shippedAt          DateTime?

  events      PaymentEvent[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // El panel lista los pedidos por estado, del más reciente al más viejo.
  @@index([status, createdAt])
}

// Registro de cada evento de Wompi que llegó con firma válida. Wompi reintenta
// solo 3 veces en 24 h, así que si algo sale mal esto es lo único que queda
// para reconstruir qué pasó. Los eventos con firma inválida no se guardan.
model PaymentEvent {
  id            String   @id @default(cuid())
  orderId       String?  // null si la referencia no corresponde a ningún pedido
  order         Order?   @relation(fields: [orderId], references: [id])

  reference     String
  transactionId String
  status        String   // APPROVED, DECLINED, VOIDED, ERROR, PENDING
  environment   String   // "test" o "prod"
  payload       Json

  createdAt     DateTime @default(now())

  @@index([reference])
  @@index([transactionId])
}
