# Plantilla de variables de entorno. Copia este archivo a ".env" (local) o
# créalo directamente en el VPS como ".env" junto a package.json, y reemplaza
# cada valor por el real. Nunca commitees el ".env" real (ya está en
# .gitignore) — solo esta plantilla, sin secretos.

# --- Base de datos (Supabase Postgres) ---
# DATABASE_URL: pooler (pgbouncer), la usa la app en cada request.
# DIRECT_URL: conexión directa, la usan Prisma Migrate/`prisma db push` y los
# scripts de scripts/ (no pasan por el pooler).
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# --- Cloudinary (imágenes) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Sitio ---
# Dominio real, CON https:// y SIN "/" al final. Alimenta canonical,
# sitemap.xml, robots.txt y OpenGraph — sin esto todo apunta a localhost.
NEXT_PUBLIC_SITE_URL="https://tudominio.com"

# --- Autenticación ---
# String largo y aleatorio: firma las cookies de sesión (admin y clientes).
# Generar con: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# --- Mayoristas ---
# El código secreto de la URL /mayoristas-<código>. Si falta, esa ruta queda
# cerrada (fail-closed) — no error, simplemente no existe para nadie.
WHOLESALE_SECRET=""

# --- Solo si el origen queda detrás de tu propio Nginx/Caddy (sin Cloudflare
# delante) --- Ver lib/client-ip.ts para el porqué. Déjalo vacío/sin definir
# si usas Cloudflare (recomendado): ahí no hace falta.
# TRUST_PROXY_XFF="1"

# --- Solo para volver a correr scripts/seed-admin.mjs (crear/actualizar el
# usuario admin). No los lee la app en producción. ---
# ADMIN_USER=""
# ADMIN_PASSWORD=""
